@@ -174,4 +174,162 @@ PointGroup-PAPER:
   cluster_type: 7
   vizual_ratio: 0
 
-  path_pretrained: "/cluster/work/igp_psr/binbin/OutdoorPanopticSeg_V2/outputs/setting1_classes5_mixtree_1000/setting1_classes5_mixtree_1000-PointGroup-PAPER-20240205_132553/PointGroup-PAPER.pt"
+  # LOCAL PATCH (SegmentedForests): was a FIVE-class checkpoint on the original author's
+  # cluster ("setting1_classes5_mixtree_1000/...PointGroup-PAPER.pt"). Two reasons it is
+  # null now:
+  #   1. The path does not exist here, so it only ever produced
+  #      "The path does not exist, it will not load any model" (base_model.py:154) --
+  #      every run was already training from scratch, by accident rather than by choice.
+  #   2. If it ever DID resolve, base_model.py calls
+  #      load_state_dict_with_same_shape(m, strict=False), which silently skips layers
+  #      whose shape changed. Our semantic head is 4-wide, that checkpoint's is 5, so the
+  #      head would be quietly dropped and you would believe you were fine-tuning.
+  # Point this at a 4-class checkpoint to fine-tune.
+  path_pretrained: null
+
+# LOCAL ADDITION (SegmentedForests): the same model on the TorchSparse 1.4 backbone.
+#
+# MinkowskiEngine stays the default -- conf/config.yaml selects PointGroup-PAPER above and
+# nothing here changes it. Ask for this one by name:
+#
+#   python train.py ... model_name=PointGroup-PAPER-TS
+#
+# WHY THIS BLOCK IS A FULL COPY and not `<<: *paper`, which is what it used to be:
+# a YAML merge key CANNOT be loaded by the omegaconf that hydra-core 1.0.7 pins (2.0.x),
+# which is what the training image has. 2.0's loader calls construct_object() on every
+# key node, so `<<` reaches an unregistered tag:yaml.org,2002:merge and raises
+# `could not determine a constructor for the tag` -- while *parsing the file*, before
+# model_name is ever read, so BOTH backbones die and the error names neither. omegaconf
+# 2.3 (the `aifor` env on the dev machine) expands merge keys happily, which is exactly
+# why this shipped: it was only ever validated off-image. Do not reintroduce the anchor.
+#
+# The duplication is guarded: misc/check_forainet_classes.py asserts this block equals
+# PointGroup-PAPER except for `class` and `backend`, and that the file still parses under
+# 2.0 semantics. Run it after editing either block.
+#
+# `class:` is the real backbone switch -- it selects the Python file, and that file's
+# import decides the sparse-conv library. (The `class: minkowski.Minkowski_Model` keys in
+# the backbone/scorer blocks above are INERT: the factory passes model_type=None, so
+# module lookup falls back to BaseFactory and resolves module_name against whatever the
+# application module imported. Editing them does nothing.)
+#
+# Gotcha: SPARSE_BACKEND in the environment silently overrides `backend` below
+# (applications/sparseconv3d.py:59-62). Unset it, or this block will not run TorchSparse.
+PointGroup-PAPER-TS:
+  class: PointGroup3heads_ts.PointGroup3heads
+  backend: "torchsparse"
+  conv_type: "SPARSE"
+  scorer_type: "unet"
+  weight_name: "latest"
+
+  use_score_net: True
+  mask_supervise: False
+  use_mask_filter_score_feature: False
+  use_mask_filter_score_feature_start_epoch: 50
+  mask_filter_score_feature_thre: 0.5
+
+  cal_iou_based_on_mask: False
+  cal_iou_based_on_mask_start_epoch: 50
+
+  loss_weights:
+    semantic: 1
+    offset_norm_loss: 0.1
+    offset_dir_loss: 0.1
+    score_loss: 1
+    mask_loss: 1
+    embedding_loss: 1
+
+  bandwidth: 0.6
+  embed_dim: 5
+  feat_size: 16
+  backbone:
+    architecture: "unet"
+    config:
+      class: minkowski.Minkowski_Model
+      conv_type: "SPARSE"
+      define_constants:
+        in_feat: ${models.PointGroup-PAPER-TS.feat_size}
+      down_conv:
+        module_name: ResNetDown
+        dimension: 3
+        down_conv_nn:
+          [
+            [ FEAT, in_feat ],
+            [ in_feat, 2*in_feat ],
+            [ 2*in_feat, 3*in_feat ],
+            [ 3*in_feat, 4*in_feat ],
+            [ 4*in_feat, 5*in_feat ],
+            [ 5*in_feat, 6*in_feat ],
+            [ 6*in_feat, 7*in_feat ],
+          ]
+        kernel_size: 3
+        stride: [ 1, 2, 2, 2, 2, 2, 2 ]
+        N: 2
+      up_conv:
+        module_name: ResNetUp
+        dimension: 3
+        up_conv_nn:
+          [
+            [ 7*in_feat, 6*in_feat ],
+            [ 2*6*in_feat, 5*in_feat ],
+            [ 2*5*in_feat, 4*in_feat ],
+            [ 2*4*in_feat, 3*in_feat ],
+            [ 2*3*in_feat, 2*in_feat ],
+            [ 2*2*in_feat, in_feat ],
+            [ 2*in_feat, in_feat ],
+          ]
+        kernel_size: 3
+        stride: [ 2, 2, 2, 2, 2, 2, 1 ]
+        N: 2
+
+  scorer_unet:
+    class: minkowski.Minkowski_Model
+    conv_type: "SPARSE"
+    define_constants:
+      in_feat: ${models.PointGroup-PAPER-TS.feat_size}
+    down_conv:
+      module_name: ResNetDown
+      dimension: 3
+      down_conv_nn: [ [ in_feat, 2*in_feat ], [ 2*in_feat, 4*in_feat ] ]
+      kernel_size: 3
+      stride: 2
+      N: 2
+    up_conv:
+      module_name: ResNetUp
+      dimension: 3
+      up_conv_nn: [ [ 4*in_feat, 2*in_feat ], [ 4*in_feat, in_feat ] ]
+      kernel_size: 3
+      stride: 2
+      N: 2
+  scorer_encoder:
+    class: minkowski.Minkowski_Model
+    conv_type: "SPARSE"
+    define_constants:
+      in_feat: ${models.PointGroup-PAPER-TS.feat_size}
+    down_conv:
+      module_name: ResNetDown
+      dimension: 3
+      down_conv_nn: [ [ in_feat, 2*in_feat ], [ 2*in_feat, 4*in_feat ] ]
+      kernel_size: 3
+      stride: 2
+      N: 2
+    innermost:
+      module_name: GlobalBaseModule
+      activation:
+        name: LeakyReLU
+        negative_slope: 0.2
+      aggr: "max"
+      nn: [ 4*in_feat, in_feat ]
+
+  prepare_epoch: 30
+  cluster_radius_search: 1.5 * ${data.grid_size}
+
+  min_iou_threshold: 0.25
+  max_iou_threshold: 0.75
+
+  cluster_type: 7
+  vizual_ratio: 0
+
+  # null for the same reason as in PointGroup-PAPER above: the upstream checkpoint is
+  # 5-class and would be loaded with strict=False, silently dropping our 4-wide head.
+  path_pretrained: null
