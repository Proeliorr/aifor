+r"""PointGroup3heads on the SparseConv3d backbone (TorchSparse 1.4).
+
+LOCAL ADDITION (SegmentedForests). A near-copy of ``PointGroup3heads.py``, differing only
+in the backbone application it builds against: four lines, marked ``# TS:`` below.
+
+**Why a copy and not an edit.** ``Minkowski(...)`` and ``SparseConv3d(...)`` are not two
+wrappers over one implementation -- they resolve the U-Net blocks against different
+modules:
+
+    applications/minkowski.py:9      from ...modules.MinkowskiEngine.api_modules import *
+    applications/sparseconv3d.py:11  from ...modules.SparseConv3d.modules import *
+
+and both then set ``modules_lib = sys.modules[__name__]``, so ``module_name: ResNetDown``
+in the yaml resolves to a *different class* in each. Editing the original in place would
+therefore change the MinkowskiEngine path as well, and the baseline recorded in
+``docs/train_logs.md`` (``Model size = 11872126``, the module tree) would stop being a
+valid reference.
+
+**MinkowskiEngine remains the default.** This file is reached only by asking for it:
+
+    python train.py ... model_name=PointGroup-PAPER      # MinkowskiEngine (default)
+    python train.py ... model_name=PointGroup-PAPER-TS   # this file, TorchSparse 1.4
+
+**Gotcha.** ``SPARSE_BACKEND`` in the environment silently overrides the ``backend`` key
+below (``applications/sparseconv3d.py:59-62``). If it is set, this file will not run
+TorchSparse regardless of the config. Unset it and select by ``model_name``.
+
+Everything else -- the three heads, clustering, scoring, losses -- is untouched and
+backend-agnostic: the model only ever reads ``.x`` off the backbone output. See
+``docs/backbone_torchsparse_1.4.md``.
+"""
+import torch
+import os
+from torch_points_kernels import region_grow
+from torch_geometric.data import Data
+from torch_scatter import scatter
+import random
+import numpy as np
+
+from torch_points3d.datasets.segmentation import IGNORE_LABEL
+from torch_points3d.models.base_model import BaseModel
+from torch_points3d.applications.sparseconv3d import SparseConv3d  # TS: was applications.minkowski.Minkowski
+from torch_points3d.core.common_modules import Seq, MLP, FastBatchNorm1d
+from torch_points3d.core.losses import offset_loss, instance_iou_loss, mask_loss, instance_ious, discriminative_loss
+from torch_points3d.core.data_transform import GridSampling3D
+from .structure_3heads import PanopticLabels, PanopticResults
+from torch_points3d.utils import hdbscan_cluster, meanshift_cluster
+from torch_points3d.utils import is_list
+from torch_points3d.utils import hdbscan_cluster
+from os.path import exists, join
+from .ply import read_ply, write_ply
+
+class PointGroup3heads(BaseModel):
+    __REQUIRED_DATA__ = [
+        "pos",
+    ]
+
+    __REQUIRED_LABELS__ = list(PanopticLabels._fields)
+
+    def __init__(self, option, model_type, dataset, modules):
+        super(PointGroup3heads, self).__init__(option)
+        backbone_options = option.get("backbone", {"architecture": "unet"})
+        # TS: all three sparse networks MUST share one backend -- set_backend() rebinds
+        # module-level globals in modules/SparseConv3d/nn/__init__.py, so the last call
+        # would otherwise decide the backend for all of them.
+        _backend = option.get("backend", "torchsparse")
+        self.Backbone = SparseConv3d(
+            backbone_options.get("architecture", "unet"),
+            input_nc=dataset.feature_dimension,
+            num_layers=4,
+            config=backbone_options.get("config", {}),
+            backend=_backend,
+        )
+
+        self._scorer_type = option.get("scorer_type", None)
+        # cluster_voxel_size = option.get("cluster_voxel_size", 0.05)
+        #TODO look at how to do back projection of GridSampling3D
+        cluster_voxel_size = False
+        if cluster_voxel_size:
+            self._voxelizer = GridSampling3D(cluster_voxel_size, quantize_coords=True, mode="mean", return_inverse=True)
+        else:
+            self._voxelizer = None
+        # TS: ScorerUnet is the one this config actually uses (scorer_type: "unet").
+        self.ScorerUnet = SparseConv3d(
+            "unet", input_nc=self.Backbone.output_nc, num_layers=4,
+            config=option.scorer_unet, backend=_backend,
+        )
+        # TS: built but never called at scorer_type "unet" -- which is fortunate, because
+        # SparseConv3dEncoder.forward reads data.C[:, 0] as the batch index
