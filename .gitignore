# Stage 1 results — one subfolder per plot, regenerated by main_pipeline.py
SegmentedForests/3DFin_output/

# Input point clouds — large binary data, not tracked
SegmentedForests/pointclouds/*.laz
SegmentedForests/pointclouds/*.las
SegmentedForests/pointclouds/*.ply

# Stage 2 results — centered ForAINet clouds + restored outputs, regenerated by
# forainet_prep.py (the small <plot>_offsets.yml files stay tracked)
SegmentedForests/ForAINet_input/*.laz
SegmentedForests/ForAINet_input/*.las
SegmentedForests/ForAINet_input/*.ply

# Per-run Hydra logs
outputs/


# Python / Jupyter cruft
__pycache__/
*.pyc
.ipynb_checkpoints/

# Offset file the misc converter writes next to itself
misc/offset.yml
